# PostgreSQL Database
DATABASE_URL="postgresql://postgres:secret@localhost:5432/auditdb"

# API Server
PORT=4000
JWT_SECRET="change-me-to-a-random-64-char-secret"
CORS_ORIGIN="http://localhost:3000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"
