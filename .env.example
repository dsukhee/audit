# ============================================================================
# ISO 27001 Audit Platform — Environment variables (жишээ)
# `.env` нэрээр хуулж аваад утгуудаа тохируулна уу.
# ============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://audit:audit@localhost:5432/audit?schema=public"

# --- API ---
API_PORT=4000
NODE_ENV=development

# --- Auth (JWT) ---
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# --- Object Storage (MinIO / S3) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="audit-evidence"
S3_FORCE_PATH_STYLE="true"

# --- AI Assistant ---
# AI_PROVIDER: "openai" | "local"
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
# Local LLM (Llama/Mistral) — OpenAI-нийцтэй endpoint
LOCAL_LLM_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama3"
